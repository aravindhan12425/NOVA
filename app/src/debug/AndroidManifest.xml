<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the developer's PC (adb, which holds DUMP) send Nova a typed command.
     Ordinary apps can't hold android.permission.DUMP, so they can't use it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.assistant.nova.debug.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
